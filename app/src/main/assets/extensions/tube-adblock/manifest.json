{
    "manifest_version": 2,
    "name": "Tube AdBlock",
    "version": "1.0.0",
    "description": "Tube content blocker",

    "browser_specific_settings": {
        "gecko": {
            "id": "tube-adblock@tuservidor.com"
        }
    },

    "permissions": [
        "webRequest",
        "webRequestBlocking",
        "<all_urls>"
    ],

    "content_scripts": [
        {
            "matches": [
                "*://youtube.com/*",
                "*://*.youtube.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ],

    "background": {
        "scripts": [
            "background.js"
        ]
    }
}
